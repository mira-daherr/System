{
  "name": "computer-center-system",
  "version": "1.0.0",
  "description": "Computer Center Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:exe": "pkg server.js --targets node18-win-x64 --output ../delivery/app.exe"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "mysql2": "^3.16.1"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.16.1",
    "nodemon": "^3.1.11"
  },
  "pkg": {
    "scripts": [
      "routes/**/*.js",
      "controllers/**/*.js",
      "models/**/*.js",
      "middleware/**/*.js",
      "config/**/*.js"
